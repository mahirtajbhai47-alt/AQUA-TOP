# Copy this file to .env and fill in real values. NEVER commit .env.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=Asia/Kolkata

# Database
# Local development: leave DATABASE_URL unset to use SQLite.
# Production (Render PostgreSQL): postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# Security (production only)
SECURE_SSL_REDIRECT=True

# Email (optional - console backend is used by default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=AquaCare <noreply@aquacare.example>

# Initial administrator (required only when running ensure_superuser)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=set-a-strong-password
